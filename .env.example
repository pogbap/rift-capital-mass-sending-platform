# Variable names only. Real values live in your deployment secret manager,
# never in this file or in source control.

# Environment selector — controls which Attio token is used and gates
# production writes. One of: development, staging, production
RM_ENV=development

# Required (in addition to RM_ENV=production) to allow any live write.
RM_CONFIRM_PRODUCTION=

# Attio — one token per environment, only the matching one is read
ATTIO_API_TOKEN_DEVELOPMENT=
ATTIO_API_TOKEN_STAGING=
ATTIO_API_TOKEN_PRODUCTION=

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
# Feature flag — set to false to freeze all Mailchimp enrollment
RM_MAILCHIMP_ENROLL_ENABLED=true

# Transactional email provider (e.g. Postmark, SES, Mailchimp Transactional)
TRANSACTIONAL_API_KEY=
TRANSACTIONAL_PROVIDER=

# Optional enrichment
UNIPILE_API_KEY=

# Tuning
RM_CADENCE_DEFAULT_DAYS=60
RM_MAX_SEQUENCE_ENROLLMENTS=25
RM_MAX_RETRIES=5
